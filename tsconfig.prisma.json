
{
  "compilerOptions": {
    "rewriteRelativeImportExtensions": true,
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "rootDir": "./generated/prisma",
    "outDir": "./dist/generated/prisma",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": ["generated/prisma/**/*.ts"],
  "exclude": ["node_modules"]
}


